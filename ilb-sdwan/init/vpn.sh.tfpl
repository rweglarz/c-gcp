#!/bin/bash
set -o xtrace

# Auto-detect primary network interface (e.g. eth0 or ens4)
PRIMARY_IF=$(ip -o link show | awk -F': ' '{print $2}' | grep -e '^eth' -e '^ens' -e '^enp' | head -n 1)

%{ for t_name, v in tunnels ~}
# Recreate XFRM point-to-point IPsec interface for ${t_name}
ip link del dev xfrm${v.if_id} 2>/dev/null || true
ip link add xfrm${v.if_id} type xfrm dev $PRIMARY_IF if_id ${v.if_id}
ip link set xfrm${v.if_id} up

# Assign the local BGP APIPA IP directly to the XFRM interface.
# This makes the remote BGP peer IP (which is .1 in the same /30 subnet) directly connected,
# allowing BIRD's protocol direct to automatically discover and resolve it.
ip addr add ${v.bgp_source_ip}/30 dev xfrm${v.if_id} 2>/dev/null || true
%{ endfor ~}

# Restart BIRD Routing Daemon after virtual link is fully established.
# This guarantees BIRD scans active XFRM links and successfully binds to its BGP source IPs on every boot.
systemctl restart bird
